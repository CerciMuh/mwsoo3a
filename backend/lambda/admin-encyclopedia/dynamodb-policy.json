{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-central-1:345204682082:table/UniversityDegrees",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/UniversityDegrees/index/*",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/DegreeCourses",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/DegreeCourses/index/*",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/CourseNotes",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/CourseNotes/index/*",
        "arn:aws:dynamodb:eu-central-1:345204682082:table/UniversityDomains"
      ]
    }
  ]
}
